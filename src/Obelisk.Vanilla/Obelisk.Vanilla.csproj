<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Obelisk.Plugins.Images\Obelisk.Plugins.Images.csproj" />
    <ProjectReference Include="..\Obelisk.Abstractions\Obelisk.Abstractions.csproj" />
    <ProjectReference Include="..\Obelisk.Runtime\Obelisk.Runtime.csproj" />
    <ProjectReference Include="..\Obelisk.Platform.Sdl3\Obelisk.Platform.Sdl3.csproj" />
    <ProjectReference Include="..\Obelisk.Graphics2D\Obelisk.Graphics2D.csproj" />
    <ProjectReference Include="..\Obelisk.Assets\Obelisk.Assets.csproj" />
    <ProjectReference Include="..\Obelisk.Plugin\Obelisk.Plugin.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- NuGet contentFiles do not flow through a meta-package's dependencies. -->
    <None Update="buildTransitive/Obelisk.Vanilla.targets" Pack="true" PackagePath="buildTransitive/Obelisk.Vanilla.targets" />
    <Content Include="../../licenses/**" Exclude="../../licenses/README.md"
             Link="licenses/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             Pack="true" PackagePath="contentFiles/any/any/licenses/"
             PackageCopyToOutput="true" PackageFlatten="false" />
  </ItemGroup>

</Project>
