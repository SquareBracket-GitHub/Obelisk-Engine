<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>obelisk</ToolCommandName>
    <PackageId>Obelisk.Cli</PackageId>
    <Description>Obelisk Engine project creation and development CLI.</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Templates/*.template" LogicalName="Templates/%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>
</Project>
