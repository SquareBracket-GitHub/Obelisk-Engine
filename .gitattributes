* text=auto
*.cs text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.sln text eol=crlf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.patch text eol=lf whitespace=-trailing-space
native/**/*.dll binary
# Keep the build manifest byte-identical to its packaged notice copy.
native/sdl3/build.json -text whitespace=cr-at-eol

# Preserve vendored license/notice bytes from fixed upstream packages.
licenses/** -text whitespace=-trailing-space,cr-at-eol
licenses/README.md text eol=lf whitespace

